# Driftmoor environment template
# ---------------------------------------------------------------
# Copy this file to .env.local (for your laptop) and/or .env.ultra
# (for runs targeting the Mac Studio). Source the appropriate one
# before invoking run_scene.py / run_all.py:
#
#     source .env.local
#     python run_scene.py fey_glade 6
#
# All variables are optional. Defaults are shown in comments.
# ---------------------------------------------------------------

# Where Ollama lives. Default: http://localhost:11434
# export OLLAMA_HOST=http://ultra:11434

# Force every agent (players, DM, narrator) onto ollama/<MODEL>,
# overriding whatever the scene .md specifies. Useful for A/B runs
# or fully offline operation. Leave unset to use scene-authored
# providers (Claude, GPT-4, local mixes, etc.).
# export LLM_FORCE_OLLAMA_MODEL=gemma3:27b

# Bump Ollama context window. Default: 16384.
# export OLLAMA_NUM_CTX=16384

# Where session directories land. Default: <repo>/runtime/state
# export DRIFTMOOR_STATE_ROOT=$HOME/Python/Driftmoor/runtime/state

# Human-readable suffix appended to the session id. Useful for
# labelling comparison runs ("baseline", "spell-fix", etc.).
# export DRIFTMOOR_SESSION_LABEL=

# Pin an explicit session id (overrides timestamp+host+model).
# Used internally by --resume; rarely set by hand.
# export DRIFTMOOR_SESSION_ID=

# Cloud provider keys (only needed if a scene .md selects them and
# LLM_FORCE_OLLAMA_MODEL is NOT set).
# export ANTHROPIC_API_KEY=
# export OPENAI_API_KEY=
# export GOOGLE_API_KEY=

# Optional browser character-creator model. With these unset the creator uses
# a deterministic offline draft, so the interface remains testable and usable.
# export DRIFTMOOR_CREATOR_PROVIDER=ollama
# export DRIFTMOOR_CREATOR_MODEL=gemma3:27b
